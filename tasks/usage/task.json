{
  "kind": "usage",
  "title": "Usage investigation",
  "when": "once a day after the usage review, for the boxes Jev was not sure about; or on demand from a box's usage profile",
  "tools": [
    "instance_apps",
    "activity_signals",
    "instance_history",
    "cloudwatch_metric",
    "instance_probe",
    "log_groups",
    "domain_inventory",
    "load_balancer_inventory",
    "recommendation_history",
    "auto_actions",
    "graph_query",
    "instance_inventory",
    "steampipe_query"
  ],
  "max_turns": 40,
  "rubric": [
    { "check": "required", "path": "verdict", "label": "a verdict is given" },
    { "check": "enum", "path": "verdict", "values": ["confirm", "adjust", "keep_running"], "label": "the verdict is confirm, adjust or keep_running" },
    { "check": "range", "path": "confidence", "min": 0, "max": 1, "label": "confidence between 0 and 1" },
    { "check": "required", "path": "reasoning", "label": "the reasoning is written" },
    { "check": "min_items", "path": "evidence[]", "min": 2, "label": "at least two pieces of evidence" },
    { "check": "numbers", "path": "evidence[]", "label": "every piece of evidence carries numbers" },
    { "check": "required", "path": "busy_hours_explained[].cause", "label": "every busy stretch has a cause" }
  ],
  "retry": { "on_score_below": 0.7, "max": 1 }
}

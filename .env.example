# Port the API + UI listen on
PORT=9034
# Shared secret for the API and the UI. Leave empty for open local dev.
API_TOKEN=
# Secret repo2graph must echo on the agent callback URL
CALLBACK_SECRET=
# Bearer token for the MCP fact server at /mcp (the agent's tool source). Leave empty for open local dev.
MCP_TOKEN=

# Scheduled full run (cron, "off" to disable)
RUN_CRON=0 6 * * *
# Lightweight watcher: instance states, NAT traffic, Savings Plans, EBS (cron, "off" to disable)
WATCH_CRON=*/30 * * * *
# After a run, hand findings to the agent: changes (only when something material changed), always, never
AGENT_AUTO_DISPATCH=changes
# NAT traffic alerts: auto (investigate every new one with the agent), manual (button / API only), off
ALERT_INVESTIGATE=auto
# SSM document the host probe runs through. The default is a custom document that embeds the fixed probe script,
# so the advisor's key can only ever run that script (the setup script creates it; or see GET /api/probe/document).
# AWS-RunShellScript would let the key run ANY command on ANY instance: only for a throwaway test, never in production.
PROBE_DOCUMENT=AwsAdvisorProbe
# Which instances the daily probe pass covers: idle (idle candidates only) or all (every SSM-online running instance)
PROBE_SCOPE=idle
# Skip instances probed more recently than this many hours (match it to PROBE_CRON: 20 for daily, 0.9 for hourly)
PROBE_MIN_INTERVAL_HOURS=20

# Steampipe. Locally: `steampipe service status --show-password` gives the URL.
STEAMPIPE_DATABASE_URL=postgres://steampipe:PASSWORD@127.0.0.1:9193/steampipe
# Where the managed connection file is written (Steampipe watches this dir)
STEAMPIPE_CONFIG_DIR=/Users/you/.steampipe/config
# Name of the Steampipe connection / Postgres schema this app owns
STEAMPIPE_CONNECTION=advisor
# Name of the AWS config profile the app writes when a role is assumed (Settings > AWS credentials); plus "<name>-source" for pasted keys
ADVISOR_AWS_PROFILE=aws-advisor
# The AWS files the managed profile goes into; the Steampipe service must read the same files (same user, or the same mounts)
#AWS_CONFIG_FILE=/Users/you/.aws/config
#AWS_SHARED_CREDENTIALS_FILE=/Users/you/.aws/credentials

# Powerpipe
POWERPIPE_BIN=powerpipe
POWERPIPE_MOD_DIR=./mod

# repo2graph (optional). Inside the swarm: http://repo2graph.sphinx:3355 and boltwall's stakwork secret.
REPO2GRAPH_URL=
REPO2GRAPH_TOKEN=
# URL repo2graph can reach this app on, for the webhook
PUBLIC_URL=http://localhost:9034
AGENT_MODEL=anthropic/claude-opus-5
# Optional: forward an LLM API key per request (handy locally; in the swarm repo2graph has its own)
AGENT_API_KEY=

# TypeSafe (Jev), optional: typed decisions for alert triage, resource roles and tier checks. Unset = no-op.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Neo4j mirror (optional): a one-way copy of resources, recommendations, decisions, alerts, incidents and rules
# for the agent, NavFiber and Neo4j Browser. Unset = off. Inside the swarm: bolt://neo4j.sphinx:7687 and the Neo4j node's password.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=
